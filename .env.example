# Copy to .env and fill in to enable cloud LLM + Cosmos. Blank = local heuristic mode.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Identity — managed identity preferred (no secrets). Leave a service's key blank
# to authenticate with the managed identity. AZURE_CLIENT_ID selects a
# user-assigned identity (optional).
USE_MANAGED_IDENTITY=true
AZURE_CLIENT_ID=

# Azure Service Bus — async job dispatch to worker(s); blank = run in-process.
SERVICEBUS_NAMESPACE=
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE=analysis-jobs

# Azure OpenAI (from Azure AI Foundry) — blank key = managed-identity auth
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Low-cost model for chunk summarisation / context compaction (low-reasoning
# adhoc work). Falls back to AZURE_OPENAI_DEPLOYMENT if left blank.
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini

# Cosmos DB — blank key = managed-identity (Entra RBAC) auth
COSMOS_ENDPOINT=
COSMOS_KEY=

# Optional GitHub token to raise public API rate limits
GITHUB_TOKEN=
