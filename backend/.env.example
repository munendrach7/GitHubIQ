# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Identity — managed identity is preferred in Azure (no secrets). When the
# service-specific *_KEY / connection string below is blank, the app uses the
# managed identity (DefaultAzureCredential). Set AZURE_CLIENT_ID only for a
# user-assigned identity.
USE_MANAGED_IDENTITY=true
AZURE_CLIENT_ID=

# Azure Service Bus — async job dispatch to worker(s). Leave both blank to run
# analyses in-process (FastAPI background task) for local dev / demos.
# Prefer the namespace (managed-identity auth); the connection string is a
# local-dev fallback.
SERVICEBUS_NAMESPACE=
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE=analysis-jobs
SERVICEBUS_MAX_LOCK_RENEWAL=3600
JOB_MAX_ATTEMPTS=3

# Azure OpenAI (Azure AI Foundry) — leave the key blank to auth via managed
# identity; leave the endpoint blank too to run in heuristic mode.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Low-cost model for chunk summarisation / context compaction (low-reasoning
# adhoc work). Falls back to AZURE_OPENAI_DEPLOYMENT if left blank.
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini

# Cosmos DB — leave the key blank to auth via managed identity (Entra RBAC);
# leave the endpoint blank to use the in-memory store.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=githubiq
COSMOS_CONTAINER=analyses

# Optional: raise GitHub rate limits for public repos
GITHUB_TOKEN=

# Auth & rate limiting
AUTH_SECRET=change-me-to-a-long-random-string
# Admin login (username is not secret). Provide the admin password at runtime;
# it is hashed in memory and never written to source.
ADMIN_USERNAME=munendra
ADMIN_PASSWORD=
RATE_LIMIT_WINDOW_HOURS=4
RATE_LIMIT_MAX_ATTEMPTS=1
